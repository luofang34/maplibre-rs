{
  "version": 8,
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f4f1ea"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#dfe9d0",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#cfe5bb"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a4cde8"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#a4cde8"
      }
    },
    {
      "id": "road",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          6,
          0.5,
          18,
          18
        ]
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": [
        "==",
        [
          "get",
          "admin_level"
        ],
        2
      ],
      "paint": {
        "line-color": "#9e9cab",
        "line-width": 1
      }
    },
    {
      "id": "rich-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "country"
      ],
      "layout": {
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-field": [
          "format",
          [
            "upcase",
            [
              "get",
              "name:latin"
            ]
          ],
          {
            "font-scale": 1.1,
            "text-font": [
              "literal",
              [
                "Noto Sans Bold"
              ]
            ]
          },
          "\n",
          {},
          [
            "coalesce",
            [
              "get",
              "name:nonlatin"
            ],
            [
              "get",
              "name"
            ]
          ],
          {
            "font-scale": 0.8
          }
        ]
      },
      "paint": {
        "text-color": "#123",
        "text-halo-color": "#fff",
        "text-halo-width": 1.5
      }
    }
  ],
  "center": [
    9.49,
    51.2
  ],
  "zoom": 4.2
}
