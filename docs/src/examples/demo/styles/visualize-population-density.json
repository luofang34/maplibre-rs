      "source-layer": "waterway",
      "paint": {
        "line-color": "#a4cde8"
      }
    },
    {
      "id": "road",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          6,
          0.5,
          18,
          18
        ]
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": [
        "==",
        [
          "get",
          "admin_level"
        ],
        2
      ],
      "paint": {
        "line-color": "#9e9cab",
        "line-width": 1
      }
    },
    {
      "id": "rwanda-provinces",
      "type": "fill",
      "source": "rwanda",
      "paint": {
        "fill-opacity": 0.7,
        "fill-color": [
          "let",
          "density",
          [
            "/",
            [
              "get",
              "population"
            ],
            [
              "get",
              "sq-km"
            ]
          ],
          [
            "interpolate",
            [
              "linear"
            ],
            [
              "zoom"
            ],
            8,
            [
              "interpolate",
              [
                "linear"
              ],
              [
                "var",
                "density"
              ],
              274,
              [
                "to-color",
                "#edf8e9"
              ],
              1551,
              [
                "to-color",
                "#006d2c"
              ]
            ],
            10,
            [
              "interpolate",
              [
                "linear"
              ],
              [
                "var",
                "density"
              ],
              274,
              [
                "to-color",
                "#eff3ff"
              ],
              1551,
              [
                "to-color",
                "#08519c"
              ]
            ]
          ]
        ]
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 12
