{
  "version": 8,
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f4f1ea"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#dfe9d0",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#cfe5bb"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a4cde8"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#a4cde8"
      }
    },
    {
      "id": "road",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          6,
          0.5,
          18,
          18
        ]
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": [
        "==",
        [
          "get",
          "admin_level"
        ],
        2
      ],
      "paint": {
        "line-color": "#9e9cab",
        "line-width": 1
      }
    },
    {
      "id": "3d-buildings",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-extrusion-color": [
          "interpolate",
          [
            "linear"
          ],
          [
            "get",
            "render_height"
          ],
          0,
          "lightgray",
          200,
          "royalblue",
          400,
          "lightblue"
        ],
        "fill-extrusion-height": [
          "get",
          "render_height"
        ],
        "fill-extrusion-base": [
          "coalesce",
          [
            "get",
            "render_min_height"
          ],
          0
        ],
        "fill-extrusion-opacity": 0.9
      }
    }
  ],
  "center": [
    -74.0066,
    40.7135
  ],
  "zoom": 15.5,
  "pitch": 45,
  "bearing": -17.6
}
